  "fixture_version": "1.0.0",
  "model": {
    "model_id": "ganjave2022.cybernetic-growth",
    "equations_version": "1.1.0",
    "parameter_set_id": "ganjave2022.table2",
    "parameter_set_version": "1.0.0",
    "parameter_set_provenance": "Table 2 as printed, p. 4, loaded as a fitted set; nothing here is refit",
    "solver": {
      "rtol": 1e-06,
      "atol": 1e-09,
      "h_max": 0.01,
      "h_max_reason": "chosen from the reported kLa = 133 h^-1 so h*kLa = 1.33 stays inside the explicit RK4 stability limit"
    }
  },
  "criteria_definitions": [
    {
      "criterion_id": "A_limiting_regime",
      "statement": "The culture becomes oxygen-limited after feeding starts: min DO over 6 <= t <= 24 h is below 10 %.",
      "threshold": {
        "min_DO_percent_over_6_to_24h": "< 10"
      },
      "justification": "The paper states it, not the implementation: printed p. 9, 'Based on the results of the DO profile, it is seen that the growth is limited by oxygen availability beyond 6 h.' The paper's own Fig. 3a and Fig. 5a model curves fall to about 1-6 %. Ten per cent is a generous bound that still separates oxygen limitation from substrate limitation: the S2-limited reading reaches a minimum DO of about 60 %, so the criterion discriminates between the two regimes rather than between two close values.",
      "kind": "paper_stated_behaviour"
    },
    {
      "criterion_id": "B_reported_endpoint",
      "statement": "Final biomass lies inside the paper's own reported experimental range for the 24 h fed-batch trials.",
      "threshold": {
        "biomass_24h_g_per_L": "within [19.9, 21.5]"
      },
      "justification": "This is the paper's reported measurement, quoted on p. 7 as the range across the tested proteins and in the abstract as 20.7 g/L. Using the reported range rather than a point value respects the run-to-run spread the paper itself reports, and avoids testing against a single number the paper never isolates. The threshold is a paper quantity; nothing in it was chosen to fit any output.",
      "kind": "paper_reported_measurement"
    },
    {
      "criterion_id": "C_model_curve_shape",
      "statement": "The biomass trajectory agrees with the authors' own plotted model prediction over the readable span.",
      "threshold": {
        "relative_rmse_percent": "<= 25"
      },
      "justification": "Two independent figures set the bar. The paper's own model sits about 1 g/L RMS from its own held-out validation data on a trajectory reaching 20 g/L (about 5 %, from the nine digitized Fig. 3b points), so a transcription that computes the same model must land well inside that. The digitization uncertainty on the reference curve is about 0.5 g/L, so 25 % is thirty times the reading noise. A threshold that loose can only fail on a genuine difference between the implemented equations and the printed ones, not on raster noise or solver tolerance.",
      "comparison_interval": "0.25 h grid over the span where the paper's curve is readable, t = 0..24 h",
      "kind": "paper_plotted_model_prediction"
    },
    {
      "criterion_id": "D_determinism",
      "statement": "Two runs of the same configuration agree.",
      "threshold": {
        "relative_difference": "<= 1e-9"
      },
      "justification": "The solver is deterministic given identical inputs and parameters. Any divergence above floating-point round-off indicates hidden state or a race, which would invalidate every other comparison. This is a property of the implementation, not of the paper.",
      "kind": "implementation_property"
    }
  ],
