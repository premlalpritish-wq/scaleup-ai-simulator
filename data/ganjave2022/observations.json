  "version": "1.0.0",
  "title": "Ganjave et al. (2022) independent experimental observations of shake-flask fed-batch E. coli HCD",
  "source": {
    "citation": "S. D. Ganjave, H. Dodia, A. V. Sunder, S. Madhu, P. P. Wangikar, 'High cell density cultivation of E. coli in shake flasks for the production of recombinant proteins', Biotechnology Reports 33 (2022) e00694.",
    "doi": "10.1016/j.btre.2021.e00694",
    "pdf": "papers/Ganjave et al 2022.pdf",
    "derived_from": "Models/Ganjave/data/figure_reference_data.json -- the paper's raster figures, digitised with per-point calibration",
    "derivation": "composition/tools/build_evaluation_dataset.py; re-run it to regenerate this file byte for byte"
  },
  "observation_policy": {
    "what_counts_as_an_observation": "A marker centre in a panel whose caption identifies the series as experimental ('experimental values'). These are readings off a published raster figure, not tabulated measurements, and they are tagged digitized=true.",
    "what_does_not": "The authors' model-predicted curve, which is a prediction and never an observation. It lives in model_predictions, never in points.",
    "no_interpolation": "Only observed times are recorded. Nothing is interpolated onto a uniform grid, and no point is invented where the figure has none.",
    "no_uncertainty_inflation": "Each point carries the digitisation's own reading and calibration uncertainties, summed per the digitisation's convention. No replicate error bar was reported by the paper, so none is claimed.",
    "missing": "The paper publishes no tabular data and no replicate error bars for these series. Nothing is imputed."
  },
  "excluded": {
    "fitting_experiment": {
      "paper_figure": 2,
      "feed": {
        "glycerol_percent_wv": 30.0,
        "yeast_extract_percent_wv": 40.0,
        "flow_mL_per_h": 0.52
      },
      "reason": "Parameters were estimated from this experiment, so comparing against it would be circular. Recorded here so its absence is a decision on the record rather than an oversight."
    }
  },
  "figure_numbering": {
    "issue": "figure_reference_data.json keys the held-out validation experiment as '5' and the selected optimum as '6'. In the paper they are Fig. 3 and Fig. 5.",
    "resolution": "Every observation carries paper_figure, and the mapping is asserted against each figure's printed caption and feed recipe at build time.",
    "map": {
      "5": 3,
      "6": 5
    }
  },
